# ═══════════════════════════════════════════════════════════
# Kimia — SaaS e-commerce RDC : variables d'environnement
# Copier en `.env` puis adapter. JAMAIS de secret dans le code.
# ═══════════════════════════════════════════════════════════

# --- Application -------------------------------------------------
# development | production (en prod : HSTS + cookie Secure + docs désactivés)
APP_ENV=development
APP_URL=http://localhost:8000

# --- Base de données / cache -------------------------------------
# PostgreSQL 18 via asyncpg (SQLAlchemy 2.0 async)
DATABASE_URL=postgresql+asyncpg://kimia:kimia@localhost:5432/kimia
# Redis 7 (rate limiting, files ARQ)
REDIS_URL=redis://localhost:6379/0

# --- Sécurité / JWT -----------------------------------------------
# Secrets à régénérer en production (openssl rand -hex 32)
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-jwt-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- SMS (Kimia) — optionnel, stub tant que non configuré ---------
KIMIA_API_URL=
KIMIA_API_KEY=

# --- Push (OneSignal) — optionnel ----------------------------------
ONESIGNAL_APP_ID=
ONESIGNAL_KEY=

# --- Erreurs (Sentry) — optionnel -----------------------------------
SENTRY_DSN=

# --- CORS ------------------------------------------------------------
# Liste JSON de domaines autorisés (Kimia + sous-domaines)
CORS_ORIGINS=["http://localhost:3000"]

# --- Divers -----------------------------------------------------------
# Répertoire de stockage des fichiers (logos, exports...)
STORAGE_PATH=/var/data
# Longueur minimale des mots de passe (la règle fine est en base :
# business_rules.password.min_length)
PASSWORD_MIN_LENGTH=8
